# Path in user repo:    .deploy-now/<project>/.env.template
# Workflow v2 — placeholder syntax: $IONOS_*
# Source: https://docs.ionos.space/docs/runtime-configuration/#application-configuration

# Symfony application environment
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=${{ secrets.APP_SECRET }}

# Application URL
APP_URL=$IONOS_APP_URL

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://$IONOS_DB_USERNAME:$IONOS_DB_PASSWORD@$IONOS_DB_HOST:3306/$IONOS_DB_NAME?serverVersion=mariadb-10.6&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN="smtp://$IONOS_MAIL_USERNAME:$IONOS_MAIL_PASSWORD@$IONOS_MAIL_HOST:$IONOS_MAIL_PORT"
###< symfony/mailer ###

###> symfony/framework-bundle ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/framework-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
