# Path in user repo:    .deploy-now/<project>/.env.template
# Path on the runtime:  .env  (rendered next to spark, in $HOME/htdocs/)
# Workflow v2 placeholder syntax — shell-style: $IONOS_DB_HOST etc.
# Source: https://docs.ionos.space/docs/runtime-configuration/#application-configuration

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = '$IONOS_APP_URL'
app.indexPage = ''
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE — MariaDB provisioned by Deploy Now
#--------------------------------------------------------------------

database.default.hostname = $IONOS_DB_HOST
database.default.database = $IONOS_DB_NAME
database.default.username = $IONOS_DB_USERNAME
database.default.password = $IONOS_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION
# Generate a strong key locally with: php spark key:generate --show
# Then store it in your repo's GitHub Actions secrets as ENCRYPTION_KEY,
# add the secret reference to the workflow customization, and replace
# the placeholder below with: hex2bin:${ENCRYPTION_KEY}
#--------------------------------------------------------------------

encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = WRITEPATH . 'session'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# MAIL — uses Deploy Now-managed sender account
#--------------------------------------------------------------------

email.protocol = 'smtp'
email.SMTPHost = $IONOS_MAIL_HOST
email.SMTPPort = $IONOS_MAIL_PORT
email.SMTPUser = $IONOS_MAIL_USERNAME
email.SMTPPass = $IONOS_MAIL_PASSWORD
email.SMTPCrypto = $IONOS_MAIL_ENCRYPTION
email.fromEmail = $IONOS_MAIL_FROM_ADDRESS
email.fromName = 'CodeIgniter 4 App'
