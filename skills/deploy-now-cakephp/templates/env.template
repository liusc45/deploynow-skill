# .deploy-now/<project>/.env.template — CakePHP
# Workflow v2 placeholder syntax: $IONOS_*

APP_NAME=CakePHP
APP_ENV=production
APP_BASE_URL=$IONOS_APP_URL

# Database
# In config/app.php, read these via env():
#   'host' => env('DB_HOST', 'localhost'),
#   'username' => env('DB_USERNAME', 'user'),
#   'password' => env('DB_PASSWORD', ''),
#   'database' => env('DB_DATABASE', 'cakephp'),
DB_HOST=$IONOS_DB_HOST
DB_DATABASE=$IONOS_DB_NAME
DB_USERNAME=$IONOS_DB_USERNAME
DB_PASSWORD=$IONOS_DB_PASSWORD
DB_PORT=3306

# Security salt — generate with: php bin/cake plugin load CakePHP/Seeds && php bin/cake seeds generate_salt
SECURITY_SALT=CHANGE_ME_GENERATE_A_REAL_SALT

# Email
EMAIL_TRANSPORT_DEFAULT_URL=smtp://$IONOS_MAIL_USERNAME:$IONOS_MAIL_PASSWORD@$IONOS_MAIL_HOST:$IONOS_MAIL_PORT
