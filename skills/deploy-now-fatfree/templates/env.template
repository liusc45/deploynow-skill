# .deploy-now/<project>/.env.template — Fat-Free Framework (F3)
# Workflow v2 placeholder syntax: $IONOS_*
# In F3, read with: $f3->get('DB_HOST')

F3_ENV=production
F3_DEBUG=0
F3_CACHE=true
F3_UI=/

DB_HOST=$IONOS_DB_HOST
DB_NAME=$IONOS_DB_NAME
DB_USERNAME=$IONOS_DB_USERNAME
DB_PASSWORD=$IONOS_DB_PASSWORD
DB_PORT=3306
